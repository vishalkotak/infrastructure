# source .env   (all values shown are the defaults)
export MS_DB_URL=postgresql+psycopg://modelstore:modelstore@localhost:5432/modelstore
# TiDB instead:  export MS_DB_URL=mysql+pymysql://root@127.0.0.1:4000/modelstore
export MS_TEMPORAL=localhost:7233
export MS_DCS=dc-a,dc-b
export MS_PROM_DC_A=http://localhost:9091
export MS_PROM_DC_B=http://localhost:9092
export MS_S3_ENDPOINT=http://localhost:9000
export MS_S3_ENDPOINT_IN_CLUSTER=http://host.minikube.internal:9000
export MS_DEPLOYABLE_STAGES=STAGING,PRODUCTION
export MS_API=http://localhost:8000
export MS_WARMUP_S=20
export MS_CANARY_WINDOW_S=60
export MS_CANARY_MAX_WINDOWS=6
export MS_SOAK_S=60
